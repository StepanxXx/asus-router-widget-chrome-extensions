{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["chrome", "node", "vite/client"]
  },
  "include": ["manifest.config.ts", "vite.config.ts", "src/**/*.ts", "src/**/*.tsx"]
}
